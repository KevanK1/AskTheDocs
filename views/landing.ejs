<!DOCTYPE html>
<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Research Engine - AI Web Scraping</title>
  <link href="https://googleapis.com" rel="preconnect" />
  <link crossorigin="" href="https://gstatic.com" rel="preconnect" />
  <link
    href="https://googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Spline+Sans:wght@300..700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#f9f506",
            "background-light": "#f8f8f5",
            "background-dark": "#23220f",
            "ink": "#1c1c0d",
            "ink-light": "#5A3B3B",
          },
          fontFamily: {
            "display": ["Spline Sans", "sans-serif"],
            "serif": ["Libre Baskerville", "serif"],
            "sans": ["Spline Sans", "sans-serif"],
          },
          borderRadius: {
            "DEFAULT": "1rem",
            "lg": "2rem",
            "xl": "3rem",
            "full": "9999px"
          },
        },
      },
    }
  </script>
  <style>
    .print-grid {
      display: grid;
      grid-template-columns: 1fr;
    }

    @media (min-width: 768px) {
      .print-grid {
        grid-template-columns: 80px 1fr;
      }
    }

    .smooth-scroll {
      scroll-behavior: smooth;
    }
  </style>
</head>

<body
  class="bg-background-light dark:bg-background-dark text-ink dark:text-background-light font-display antialiased smooth-scroll selection:bg-primary selection:text-ink overflow-x-hidden">
  <div class="relative flex min-h-screen flex-col">
    <!-- Header -->
    <header class="w-full px-6 py-4 md:py-6 flex justify-center border-b border-ink/5 bg-background-light/80 backdrop-blur sticky top-0 z-40">
      <div class="w-full max-w-[1000px] flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 group cursor-pointer shrink-0">
          <span class="material-symbols-outlined text-2xl md:text-3xl transition-transform group-hover:scale-110">youtube_searched_for</span>
          <span class="font-bold text-lg tracking-tight">Ask The Docs</span>
        </a>
        
        <!-- Desktop Navigation Bar -->
        <nav class="hidden md:flex gap-8 text-sm font-medium text-ink/70 items-center">
          <a class="hover:text-ink transition-colors" href="#documentation">Documentation</a>
          <a class="hover:text-ink transition-colors" href="#manifesto">Manifesto</a>
          <a class="hover:text-ink transition-colors" href="#how-it-works">System Logic</a>
          <% if (locals.user) { %>
            <span class="text-ink/40 border-l border-ink/20 pl-4 text-xs font-mono max-w-[180px] truncate">
              <%= user.email %>
            </span>
            <a class="h-9 px-4 rounded-full border border-red-200 text-red-600 font-bold hover:bg-red-50 text-xs flex items-center justify-center transition-colors uppercase tracking-wider" href="/auth/logout">Logout</a>
          <% } else { %>
            <button id="loginLink" class="h-9 px-5 rounded-full bg-primary text-ink font-bold text-xs tracking-wide hover:bg-[#e0dd05] shadow-sm transition-colors flex items-center justify-center">
              Login
            </button>
          <% } %>
        </nav>

        <!-- Mobile Context Actions Button Panel -->
        <div class="flex md:hidden items-center gap-2">
          <% if (locals.user) { %>
            <a class="h-8 px-3 rounded-full border border-red-200 text-red-600 font-bold text-[10px] uppercase tracking-wider flex items-center justify-center" href="/auth/logout">Logout</a>
          <% } else { %>
            <button id="mobileLoginLink" class="h-8 px-4 rounded-full bg-primary text-ink font-bold text-xs tracking-wide hover:bg-[#e0dd05] transition-colors flex items-center justify-center">
              Login
            </button>
          <% } %>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 w-full px-6 pb-8">
      <!-- Hero Section -->
      <div class="mx-auto max-w-[1000px] mt-8 md:mt-12 mb-16 md:mb-24 flex flex-col md:flex-row items-center gap-8">
        <div class="flex-1 max-w-[640px]">
          <div class="flex mb-4 md:mb-6">
            <span class="text-xs font-bold tracking-[0.15em] uppercase text-ink/60 border-b border-ink/20 pb-2">
              Intelligent Parsing Engine v1.0
            </span>
          </div>
          <h1
            class="font-serif text-3xl md:text-5xl lg:text-[56px] leading-[1.1] font-normal text-ink mb-4 md:mb-6 tracking-tight">
            Transforming<br />information access.
          </h1>
          <p class="text-base md:text-lg leading-relaxed text-ink/80 max-w-[640px] mb-6 font-light">
            Paste any documentation or blog URL. Ask complex questions.
            Receive context-grounded answers instantly, powered by a semantic
            understanding engine that reads like a human researcher.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
            <a href="/tool"
              class="h-12 px-8 rounded-full bg-primary text-ink font-bold text-sm tracking-wide hover:bg-[#e0dd05] transition-colors flex items-center justify-center min-w-[140px]">
              Let's Start
            </a>
            <a class="h-12 px-8 rounded-full border border-ink/20 text-ink font-medium text-sm tracking-wide hover:bg-ink/5 transition-colors flex items-center justify-center min-w-[140px]"
              href="#how-it-works">
              How it works
            </a>
          </div>
        </div>

        <!-- Hero Illustration -->
        <div class="hidden md:flex flex-1 justify-center items-center relative w-full h-[400px]">
          <div class="relative w-[380px] h-[380px]">
            <svg class="w-full h-full text-ink drop-shadow-sm" viewBox="0 0 400 400" xmlns="http://w3.org">
              <path d="M50,200 Q150,50 350,200" fill="none" stroke="currentColor" stroke-dasharray="6 6"
                stroke-opacity="0.1" stroke-width="1.5"></path>
              <path d="M50,200 Q150,350 350,200" fill="none" stroke="currentColor" stroke-dasharray="6 6"
                stroke-opacity="0.1" stroke-width="1.5"></path>
              <path d="M60,280 C100,280 80,120 160,120 S240,280 340,160" fill="none" stroke="currentColor"
                stroke-linecap="round" stroke-width="2"></path>
              <path d="M80,140 C120,140 140,260 220,260 S300,100 320,120" fill="none" stroke="currentColor"
                stroke-linecap="round" stroke-opacity="0.4" stroke-width="1.5"></path>
              <g class="fill-background-light stroke-ink" stroke-width="2">
                <circle cx="60" cy="280" r="6"></circle>
                <circle cx="160" cy="120" r="6"></circle>
                <circle cx="340" cy="160" r="6"></circle>
                <circle cx="80" cy="140" r="4" stroke-opacity="0.6"></circle>
                <circle cx="220" cy="260" r="4" stroke-opacity="0.6"></circle>
              </g>
              <circle cx="160" cy="120" fill="none" r="16" stroke="#f9f506" stroke-opacity="0.8" stroke-width="2">
              </circle>
              <circle cx="160" cy="120" fill="none" r="30" stroke="#f9f506" stroke-dasharray="4 4" stroke-opacity="0.3"
                stroke-width="1"></circle>
              <circle cx="110" cy="200" fill="currentColor" fill-opacity="0.3" r="2"></circle>
              <circle cx="200" cy="190" fill="currentColor" fill-opacity="0.3" r="2"></circle>
              <circle cx="280" cy="210" fill="currentColor" fill-opacity="0.3" r="2"></circle>
            </svg>
          </div>
        </div>
      </div>

      <!-- How It Works Section -->
      <div class="mx-auto max-w-[800px] border-t border-ink/10 pt-16 md:pt-24" id="how-it-works">
        <div class="mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-ink/40">Technical Workflow</span>
          <h2 class="font-serif text-2xl md:text-3xl text-ink mt-1">System Logic</h2>
        </div>

        <div class="flex flex-col gap-12 md:gap-16">
          <!-- Step 01 -->
          <div class="print-grid gap-6 md:gap-12 group">
            <div class="text-ink/30 font-serif text-4xl md:text-5xl leading-none group-hover:text-primary transition-colors duration-500 select-none">01</div>
            <div class="flex flex-col pt-2">
              <h3 class="text-lg font-bold text-ink mb-2">Ingestion</h3>
              <p class="text-ink/70 leading-relaxed text-base md:text-lg font-light">
                Paste the URL source of any technical documentation, blog post, or article. The engine validates the accessibility of the content.
              </p>
            </div>
          </div>

          <!-- Step 02 -->
          <div class="print-grid gap-6 md:gap-12 group">
            <div class="text-ink/30 font-serif text-4xl md:text-5xl leading-none group-hover:text-primary transition-colors duration-500 select-none">02</div>
            <div class="flex flex-col pt-2">
              <h3 class="text-lg font-bold text-ink mb-2">Query Formulation</h3>
              <p class="text-ink/70 leading-relaxed text-base md:text-lg font-light">
                Ask natural language questions about the content. From specific implementation details to broad summaries.
              </p>
            </div>
          </div>

          <!-- Step 03 -->
          <div class="print-grid gap-6 md:gap-12 group">
            <div class="text-ink/30 font-serif text-4xl md:text-5xl leading-none group-hover:text-primary transition-colors duration-500 select-none">03</div>
            <div class="flex flex-col pt-2">
              <h3 class="text-lg font-bold text-ink mb-2">Semantic Parsing</h3>
              <p class="text-ink/70 leading-relaxed text-base md:text-lg font-light">
                The AI breaks down the document structure, identifies context, and isolates relevant text payloads matching your intent.
              </p>
            </div>
          </div>

          <!-- Step 04 -->
          <div class="print-grid gap-6 md:gap-12 group">
            <div class="text-ink/30 font-serif text-4xl md:text-5xl leading-none group-hover:text-primary transition-colors duration-500 select-none">04</div>
            <div class="flex flex-col pt-2">
              <h3 class="text-lg font-bold text-ink mb-2">Synthesis</h3>
              <p class="text-ink/70 leading-relaxed text-base md:text-lg font-light">
                Receive a direct, cited answer. No hallucinations, just facts grounded strictly in the source material provided.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Documentation Section -->
      <div class="mx-auto max-w-[800px] border-t border-ink/10 pt-16 md:pt-24 mt-24" id="documentation">
        <div class="mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-ink/40">API & Usage Guide</span>
          <h2 class="font-serif text-2xl md:text-3xl text-ink mt-1">Documentation Reference</h2>
        </div>
        <div class="space-y-6 text-ink/80 font-light leading-relaxed text-base md:text-lg">
          <p>
            Welcome to the developer playground interface logs. This system is designed to provide rapid knowledge-base indexing directly via REST endpoints.
          </p>
          <div class="bg-ink text-background-light p-6 rounded-lg font-mono text-sm space-y-3 overflow-x-auto my-4">
            <div class="text-primary/70">// Endpoint Target Router Hook</div>
            <div><span class="text-primary">POST</span> /api/ask</div>
            <div class="text-primary/70">// Required JSON Payload Input Body Matrix</div>
            <div class="text-white/90">{</div>
            <div class="pl-4">"url": <span class="text-primary">"https://example.com"</span>,</div>
            <div class="pl-4">"question": <span class="text-primary">"How do I setup this package?"</span></div>
            <div class="text-white/90">}</div>
          </div>
          <p>
            The ingestion processor strips non-semantic layout attributes like navigation frames, sidebars, and trackers automatically—retaining pure markdown headers and text arrays before feeding them into our high-density contextual window.
          </p>
        </div>
      </div>

      <!-- Manifesto Section -->
      <div class="mx-auto max-w-[800px] border-t border-ink/10 pt-16 md:pt-24 mt-24" id="manifesto">
        <div class="mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-ink/40">Core Values</span>
          <h2 class="font-serif text-2xl md:text-3xl text-ink mt-1">Our Manifesto</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-ink/80 font-light leading-relaxed text-base">
          <div class="space-y-4">
            <h4 class="font-serif text-lg font-bold text-ink">01. Zero Hallucination Standard</h4>
            <p>
              Traditional Large Language Models are prone to inventing data configurations under pressure. We believe answers should only exist if they are explicitly grounded within a verifiable source domain string parameter.
            </p>
          </div>
          <div class="space-y-4">
            <h4 class="font-serif text-lg font-bold text-ink">02. Democratic Compute Boundaries</h4>
            <p>
              Publicly available portfolio prototypes shouldn't be exploited by greedy scripting routines. By layering identity tokens over standard email routers, we distribute platform resources evenly and transparently.
            </p>
          </div>
        </div>
      </div>

      <!-- CTA Ingestion Block -->
      <div class="mx-auto max-w-[800px] mt-32 mb-20">
        <div class="bg-ink text-background-light p-8 md:p-12 rounded-lg md:rounded-xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 rounded-full blur-[80px] -mr-32 -mt-32 pointer-events-none"></div>
          <div class="relative z-10">
            <h2 class="font-serif text-2xl md:text-3xl mb-6">Ready to accelerate your research?</h2>
            <div class="flex flex-col sm:flex-row gap-4">
              <input id="heroUrl"
                class="flex-1 bg-white/10 border border-white/20 text-white placeholder-white/50 rounded-full px-6 h-12 focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
                placeholder="Paste a documentation URL here..." type="text" />
              <button id="analyzeBtn"
                class="h-12 px-8 rounded-full bg-primary text-ink font-bold text-sm tracking-wide hover:bg-[#e0dd05] transition-colors whitespace-nowrap flex items-center justify-center">
                Analyze
              </button>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- The Re-engineered Secure Login Modal Container Component -->
    <div id="cta-login" class="<%= locals.message || locals.step === 'verify' ? '' : 'hidden' %> fixed inset-0 z-50 flex items-center justify-center bg-ink/60 px-6 backdrop-blur-sm animate-fade-in" role="dialog" aria-modal="true" aria-labelledby="loginTitle">
      <div class="w-full max-w-md rounded-lg bg-background-light p-8 shadow-2xl border border-ink/10 relative">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <p class="mb-1 text-xs font-bold uppercase tracking-[0.15em] text-ink/50">Developer Gateway</p>
            <h2 id="loginTitle" class="font-serif text-2xl text-ink font-normal">
              <%= locals.step === 'verify' ? 'Confirm OTP Access' : 'Secure Verification' %>
            </h2>
          </div>
          <button type="button" id="closeLogin" class="text-3xl leading-none text-ink/40 hover:text-ink transition-colors" aria-label="Close login">&times;</button>
        </div>

        <% if (locals.message) { %>
          <div class="mb-5 rounded-lg border border-primary/40 bg-primary/10 px-4 py-3 text-xs text-ink/80 font-medium tracking-wide">
            <%= message %>
          </div>
        <% } %>

        <% if (locals.step === 'verify') { %>
          <form method="post" action="/auth/verify-otp" class="space-y-4">
            <input type="hidden" name="email" value="<%= email %>" />
            <div class="space-y-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink/60" for="otpToken">Enter 6-Digit Code</label>
              <input id="otpToken" name="otpToken" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required
                class="h-12 w-full rounded-full border border-ink/20 bg-white px-5 text-center text-xl font-bold tracking-[0.5em] text-ink outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                placeholder="123456" />
            </div>
            <button type="submit" class="h-12 w-full rounded-full bg-primary font-bold text-ink hover:bg-[#e0dd05] shadow-sm tracking-wide text-sm transition-colors mt-2">
              Verify Token
            </button>
          </form>
          <p class="mt-4 text-center text-xs text-ink/50 font-light">Numerical access token dispatched to <strong><%= email %></strong></p>
        <% } else { %>
          <form method="post" action="/auth/send-otp" class="space-y-4">
            <div class="space-y-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-ink/60" for="loginEmail">Email Address</label>
              <input id="loginEmail" name="email" type="email" autocomplete="email" required
                class="h-12 w-full rounded-full border border-ink/20 bg-white px-5 text-ink outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                placeholder="developer@domain.com" />
            </div>
            <button type="submit" class="h-12 w-full rounded-full bg-primary font-bold text-ink hover:bg-[#e0dd05] shadow-sm tracking-wide text-sm transition-colors mt-2">
              Send Passcode
            </button>
          </form>
          <p class="mt-4 text-center text-xs text-ink/40 font-light">Your email is monitored solely to enforce the 3-prompt sandbox limit.</p>
        <% } %>
      </div>
    </div>

    <!-- Footer -->
    <footer class="w-full px-6 py-8 border-t border-ink/10">
      <div
        class="max-w-[800px] mx-auto flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-medium text-ink/50 uppercase tracking-wider">
        <p>© 2026 Research Engine Inc.</p>
        <div class="flex gap-6">
          <a class="hover:text-ink transition-colors" href="#">Privacy</a>
          <a class="hover:text-ink transition-colors" href="#">Terms</a>
          <a class="hover:text-ink transition-colors" href="#">Contact</a>
        </div>
      </div>
    </footer>
  </div>

<script>
  // Wrap your layout queries inside a load listener to ensure elements exist!
  window.addEventListener('DOMContentLoaded', () => {
    const loginModal = document.getElementById('cta-login');
    const loginLink = document.getElementById('loginLink');
    const mobileLoginLink = document.getElementById('mobileLoginLink');
    const closeLogin = document.getElementById('closeLogin');

    const openLogin = (event) => {
      event.preventDefault();
      if (loginModal) loginModal.classList.remove('hidden');
    };

    // Attach event listeners safely
    loginLink?.addEventListener('click', openLogin);
    mobileLoginLink?.addEventListener('click', openLogin);

    closeLogin?.addEventListener('click', () => loginModal?.classList.add('hidden'));
    
    loginModal?.addEventListener('click', (event) => {
      if (event.target === loginModal) loginModal.classList.add('hidden');
    });

    // Handle document parsing trigger button
    document.getElementById('analyzeBtn')?.addEventListener('click', (event) => {
      const url = document.getElementById('heroUrl').value.trim();
      if (url) {
        event.preventDefault();
        window.location.href = `/tool?url=${encodeURIComponent(url)}`;
      } else {
        window.location.href = '/tool';
      }
    });

    // Automatic link interceptor for Supabase email-link redirects
    const hash = window.location.hash;
    if (hash && hash.includes('access_token')) {
      const params = new URLSearchParams(hash.replace('#', '?'));
      const accessToken = params.get('access_token');

      if (accessToken) {
        if (loginModal) {
          loginModal.classList.remove('hidden');
          const titleEl = document.getElementById('loginTitle');
          if (titleEl) titleEl.innerText = 'Authenticating link...';
        }

        fetch('/auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ isLinkRedirect: true, token: accessToken })
        })
        .then(response => {
          if (response.ok) {
            window.location.href = '/tool';
          } else {
            return response.json().then(errData => {
              alert(errData.error || 'Authentication link failed or expired.');
              window.location.hash = '';
            });
          }
        })
        .catch(error => console.error('Link login processing failed:', error));
      }
    }
  });
</script>

</body>

</html>